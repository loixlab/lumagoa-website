<!doctype html>
<html lang="en" data-theme="pastel">
<%- include('./src/partials/head.ejs', {
    title: 'Yoga Shala Palolem South Goa | Authentic Yoga Classes at Luma Goa',
    description: 'Experience authentic yoga in Palolem at Luma Goa\'s new yoga shala. Drop-in classes, retreats, and sound baths in a serene beachside setting. Book now!',
    extraMeta: `<meta property="og:url" content="${siteUrl}/yoga">
    <meta property="og:image" content="${siteUrl}/img/yoga-shala-hero_og.jpg">
    <meta name="twitter:url" content="${siteUrl}/yoga">
  <meta name="twitter:image" content="${siteUrl}/img/yoga-shala-hero_twitter.jpg">`,
extraContent: `<link rel="canonical" href="${siteUrl}/yoga" />`,
schemaData: {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Luma Goa Yoga Shala",
  "description": "Serene yoga shala in Palolem, South Goa offering authentic yoga classes, retreats, and sound baths in a peaceful beachside setting.",
  "url": siteUrl + "/yoga",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Palolem Down St",
    "addressLocality": "Palolem",
    "addressRegion": "South Goa",
    "postalCode": "403702",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 15.0126252,
    "longitude": 74.0210419
  },
  "telephone": phone.display,
  "email": email,
  "image": siteUrl + "/img/yoga-shala-hero_display.jpg",
  "parentOrganization": {
    "@type": "Hotel",
    "name": "Luma",
    "url": siteUrl + "/"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Yoga Classes and Retreats",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Drop-in Yoga Classes",
          "description": "Join our morning flow and evening relaxation classes for " + prices.dropIn + " INR."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Sound Bath Sessions",
          "description": "Experience restorative sound healing for " + prices.soundBath + " INR."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Contact Improvisation Workshop",
          "description": "Explore movement and connection through guided contact improvisation for 500 INR."
        }
      }
    ]
  },
  // One Event per class from the build date on, from the schedule Google Sheet.
  ...(yogaSchedule.jsonLdEvents.length > 0 ? { "event": yogaSchedule.jsonLdEvents } : {})
}
}) %>

<body class="bg-white pt-[75px] text-gray-900 antialiased md:pt-[102px]">
  <%- include('./src/partials/analytics-noscript.ejs') %>

  <!-- Header -->
  <%- include('./src/partials/header.ejs') %>

  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[70vh] flex items-center justify-center py-20 overflow-hidden bg-stone-900">

      <div class="absolute inset-0 z-0">
        <img src="/img/yoga-shala-hero_display.jpg" alt="Morning yoga session at LUMA Yoga Shala Palolem South Goa" class="w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-gradient-to-b from-stone-900/90 via-transparent to-stone-900/70"></div>
      </div>

      <div class="container mx-auto px-6 max-w-5xl relative z-1 text-center">
        <div class="space-y-6">
          <h2 class="text-xs uppercase tracking-[0.4em] text-secondary font-bold">
            LUMA Yoga Shala Palolem &bull; South Goa
          </h2>

          <h1 class="text-5xl md:text-7xl font-display text-white leading-tight">
            Movement to <br /><span class="italic font-light text-stone-300">Restore the Soul.</span>
          </h1>

          <p class="text-lg md:text-xl text-stone-200 leading-relaxed max-w-2xl mx-auto">
            Experience authentic Hatha and Vinyasa Yoga in our shaded sanctuary. Designed for those looking to recharge in the heart of Palolem.
          </p>

          <div class="pt-8">
            <a href="#schedule" class="px-10 py-4 bg-[#c66f54] text-white rounded-full inline-block hover:bg-opacity-90 transition-all shadow-xl font-bold tracking-wide">
              View Weekly Schedule
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Presentation Section -->
    <section class="py-12 bg-gray-50">
      <div class="px-6 lg:container lg:mx-auto">
        <div class="max-w-5xl mx-auto text-center">
          <h2 class="font-display text-3xl font-bold mb-6 md:text-5xl">Find Your Center at Luma Goa</h2>

          <p class="text-lg leading-relaxed mb-6">
            Welcome to our brand-new yoga shala — a light-filled sanctuary immersed in tropical greenery, moments from the serene shores of Palolem Beach in South Goa’s most relaxed village.
          </p>

          <p class="text-lg leading-relaxed mb-6">
            This peaceful 85 m² space invites gentle flows, yin, meditation, and sound baths, all wrapped in natural sounds and sea breezes.
          </p>

          <p class="text-lg leading-relaxed">
            Come as you are — beginners to advanced — and rediscover stillness in paradise.
          </p>
        </div>
      </div>
    </section>

    <!-- Weekly Schedule Section -->
    <section id="schedule" class="py-18">
      <div class="px-6 lg:container lg:mx-auto">
        <h2 class="text-center font-display text-3xl font-bold mb-8 md:text-5xl">Weekly Schedule</h2>

        <%- include('./src/partials/yoga-schedule.ejs', { schedule: yogaSchedule }) %>

        <!-- Pricing -->
        <div class="mt-12 container max-w-4xl mx-auto text-center">
          <h3 class="text-center font-display text-xl mb-8 md:text-2xl">Prices</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="text-center">
              <h4 class="font-bold text-xl mb-2">Drop-in classes</h4>
              <p><%= prices.dropIn %> INR per class</p>
              <%# A class with its own Price in the schedule sheet shows it on
                  its card; every other class costs the drop-in price. %>
              <p class="mt-2 text-sm text-stone-600">Applies to every class unless a different price is shown on the class in the schedule above.</p>
            </div>
            <div class="text-center">
              <h4 class="font-bold text-xl mb-2">Sound bath</h4>
              <p><%= prices.soundBath %> INR per session</p>
              <p class="mt-2 text-sm text-stone-600">Limited spots — call or WhatsApp <a href="tel:<%= phone.tel %>" class="text-brand-brown underline decoration-primary/30 hover:decoration-primary"><%= phone.display %></a> to book.</p>
            </div>
          </div>
          <p class="mt-10 text-stone-600">
            Staying with us? Yoga is included in <a href="/yoga-holidays" class="text-brand-brown underline decoration-primary/30 hover:decoration-primary">every LUMA yoga holiday</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="py-12 bg-stone-50/50">
      <div class="container mx-auto px-6 text-center">
        <div class="max-w-2xl mx-auto space-y-4">
          <p class="text-xl font-display text-stone-800 italic leading-relaxed">
            "After your morning flow in the Shala, join us at Roots & Bloom for a plant-based breakfast."
          </p>
          <a href="/cafe-restaurant" class="inline-block text-xs uppercase tracking-[0.2em] font-bold text-brand-brown border-b border-primary pb-1 hover:text-stone-500 hover:border-stone-500 transition-colors">
            Discover the Café Menu &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="bg-base-100 py-12 text-white" data-theme="dim">
      <div class="px-6 lg:container lg:mx-auto">
        <h2 class="text-center font-display text-3xl font-bold mb-12 md:text-5xl">Gallery</h2>
      </div>
      <div class="px-2">
        <div class="relative w-full" id="masonry-grid" x-data="masonryGallery('gallery-shala-img-metadata.json')">
          <!-- Sizer elements for precision -->
          <div class="grid-sizer hidden"></div>
          <!-- Hidden to not take space visually -->
          <div class="gutter-sizer hidden"></div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/01.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/01.jpg" alt="Serene yoga practice under palms" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/02.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/02.jpg" alt="Light-filled shala near beach" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/08.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/08.jpg" alt="Elevated yoga shala surrounded by nature" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/03.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/03.jpg" alt="Spacious yoga shala interior" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/04.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/04.jpg" alt="Peaceful yoga space surrounded by nature" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/05.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/05.jpg" alt="Tropical yoga shala with palm trees" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/06.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/06.jpg" alt="Shaded yoga shala design" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/07.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/07.jpg" alt="Serene yoga environment in Palolem" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/09.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/09.jpg" alt="Natural light in yoga shala" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/10.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/10.jpg" alt="Tranquil yoga space with greenery" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/11.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/11.jpg" alt="Elevated platform yoga shala" loading="lazy" />
            </a>
          </div>
          <div class="grid-item rounded-lg p-2">
            <a class="h-full w-full overflow-hidden" href="/img/gallery-shala/large/12.jpg" data-cropped="true" target="_blank">
              <img class="gallery-thumb h-auto w-full rounded-lg object-cover" src="/img/gallery-shala/524/12.jpg" alt="Peaceful yoga retreat setting" loading="lazy" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Specifications Section -->
    <section class="py-12 bg-gray-50">
      <div class="px-6 lg:container lg:mx-auto">
        <h2 class="text-center font-display text-3xl font-bold mb-8 md:text-5xl">Our Peaceful Yoga Space</h2>
        <p class="text-lg text-base-content/80 max-w-3xl mx-auto text-center leading-relaxed">
          Elevated amid lush palms and just steps from Palolem's tranquil waves, our new shala creates an undisturbed haven for practice. Spacious yet intimate at 85 m², it invites focused asana, breathwork, and deep rest surrounded by nature's gentle rhythm.
        </p>
        <div class="mt-12 grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
              <img src="/img/icon-nature.png" alt="Nature icon" class="w-20 h-20 text-white" />
            </div>
            <h3 class="font-bold text-xl mb-2">Elevated & Surrounded by Nature</h3>
            <p>Brand-new shala built on a peaceful elevated platform, immersed in tropical greenery and coconut palms for complete calm and privacy.</p>
          </div>

          <div class="text-center">
            <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
              <img src="/img/icon-space.png" alt="Space icon" class="w-20 h-20 text-white" />
            </div>
            <h3 class="font-bold text-xl mb-2">Spacious 85 m² Design</h3>
            <p>Roomy open layout comfortably accommodates up to 20 students + teacher — perfect for group classes, workshops or personal practice.</p>
          </div>

          <div class="text-center">
            <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
              <img src="/img/icon-props.png" alt="Props icon" class="w-20 h-20 text-white" />
            </div>
            <h3 class="font-bold text-xl mb-2">Premium Yoga Props</h3>
            <p>High-quality 6 mm thick mats, bolsters, meditation cushions, pillows and eye pillows — everything provided for maximum comfort and support.</p>
          </div>

          <div class="text-center">
            <!-- Optional 4th card for emphasis -->
            <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
              <img src="/img/icon-peace.png" alt="Peace icon" class="w-20 h-20 text-white" />
            </div>
            <h3 class="font-bold text-xl mb-2">Ultra Peaceful Location</h3>
            <p>Quiet natural setting only 200 meters from Palolem Beach — close enough for sunrise beach walks, far enough for undisturbed tranquility.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Teachers Section -->
    <section class="py-16 bg-white">
      <div class="px-6 lg:container lg:mx-auto">
        <h2 class="text-center font-display text-3xl font-bold mb-12 md:text-5xl">Meet Your Teachers</h2>
        <p class="text-center text-lg max-w-3xl mx-auto mb-12 leading-relaxed">
          Our experienced facilitators bring heart-centered teaching rooted in tradition and presence. Join us for authentic guidance in a peaceful setting just 200 m from Palolem Beach.
        </p>

        <!-- Each card's id is what the schedule sheet's Teachers tab links a
             name to ("#teacher-ashutosh" in its Link column), so keep the
             id when editing a card and give a new card one (teacher-<first
             name, lower-case>). scroll-mt keeps the anchored card clear of
             the fixed header. -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10">
          <!-- Teacher Card 1 -->
          <div id="teacher-ashutosh" class="text-center scroll-mt-[75px] md:scroll-mt-[102px]">
            <img src="/img/teachers/ashutosh.jpg" alt="Ashutosh - Yoga Teacher Luma Goa Palolem" class="w-48 h-48 rounded-full mx-auto mb-6 object-cover shadow-lg" />
            <h3 class="font-bold text-2xl mb-2">Ashutosh</h3>
            <p class="text-lg text-gray-600 mb-4">Hatha, Vinyasa & Ashtanga Teacher • RYT 500 • 6+ Years Experience</p>
            <p class="text-base">Trained in Rishikesh with a 500-hour Yoga Alliance certification, Ashutosh brings over six years of professional teaching experience.<br />His path has taken him from leading Ashtanga classes at RYTTC Rishikesh to guiding daily yoga, meditation and breathwork at a Himalayan retreat in Ladakh. Grounded in a deep understanding of anatomy, his Hatha and Vinyasa classes balance strength, alignment and breath, and he adapts each practice to every level and body.<br />Attentive and warmly encouraging, he invites you to move with intention and leave feeling restored. His classes are the perfect start or close to your day in our palm-shaded shala in Palolem.</p>
          </div>
          <!-- <div id="teacher-pankaj" class="text-center scroll-mt-[75px] md:scroll-mt-[102px]">
            <img src="/img/teachers/pankaj.jpg" alt="Pankaj Kamal - Yoga Therapist and Philosopher Luma Goa Palolem" class="w-48 h-48 rounded-full mx-auto mb-6 object-cover shadow-lg" />
            <h3 class="font-bold text-2xl mb-2">Pankaj Kamal</h3>
            <p class="text-lg text-gray-600 mb-4">M.Sc Yoga Therapy • MA Philosophy • RYT 500 • 10+ Years Experience</p>
            <p class="text-base">Pankaj Kamal brings over 10 years of dedicated teaching experience to every class, blending scientific precision with profound philosophical insight. Holding an M.Sc in Yoga Therapy, an MA in Philosophy, and a 500-hour RYT certification, he specializes in therapeutic yoga practices that address body, mind, and spirit holistically. His sessions offer clear, compassionate guidance — helping students build strength, release tension, and cultivate lasting inner balance in our peaceful, nature-immersed shala.</p>
          </div> -->
          <div id="teacher-emilia" class="text-center scroll-mt-[75px] md:scroll-mt-[102px]">
            <img src="/img/teachers/emilia.jpg" alt="Emilia Maljarow - Luma Goa Palolem" class="w-48 h-48 rounded-full mx-auto mb-6 object-cover shadow-lg" />
            <h3 class="font-bold text-2xl mb-2">Emilia Maljarow</h3>
            <p class="text-lg text-gray-600 mb-4">Yoga, Pilates & Massage Therapist • 6+ Years Experience</p>
            <p class="text-base">Emilia’s journey with yoga began at the age of 16, when she first discovered the transformative power of movement, breath and mindfulness. What started as a personal practice soon became a deep passion and eventually her life's work.<br /> For over six years, she has been teaching yoga and guiding people through practices that support not only the physical body, but also mental and emotional wellbeing. Her teaching is rooted in a holistic approach, combining mindful movement, breathwork and nervous system regulation to create experiences that feel grounding, empowering and deeply restorative.<br /> Alongside yoga, she also teaches Pilates and works as a massage therapist, which allows her to bring a strong understanding of the body, alignment and recovery into her classes and retreats. Her intention is to help people reconnect with themselves, build strength from within and create balance in both body and mind.</p>
          </div>
          <!-- <div id="teacher-nicky" class="text-center scroll-mt-[75px] md:scroll-mt-[102px]">
            <img src="/img/teachers/nicky.jpg" alt="Nicky - Luma Goa Palolem" class="w-48 h-48 rounded-full mx-auto mb-6 object-cover shadow-lg" />
            <h3 class="font-bold text-2xl mb-2">Nicky</h3>
            <p class="text-lg text-gray-600 mb-4">Kundalini, Vinyasa & Yin Yoga Teacher</p>
            <p class="text-base">Nicky offers dynamic yet grounding, breath-led classes that blend Kundalini sequences with mindful movement and moments of stillness. Her teaching supports embodied awareness, vitality, and nervous system regulation.
              In her Yin classes, she guides slow, long-held postures with conscious breathing, supporting deep release, grounding, and rest.</p>
          </div> -->
          <!-- <div id="teacher-sunny" class="text-center scroll-mt-[75px] md:scroll-mt-[102px]">
            <img src="/img/teachers/sunny.jpg" alt="Sunny - Yoga & Sound Healing Teacher at Luma Goa Palolem" class="w-48 h-48 rounded-full mx-auto mb-6 object-cover shadow-lg" />
            <h3 class="font-bold text-2xl mb-2">Sunny</h3>
            <p class="text-lg text-gray-600 mb-4">Yoga & Sound Healing Guide • 9+ Years Experience</p>
            <p class="text-base">With nearly a decade of experience guiding yoga and natural therapies, Sunny brings a grounded, heart-centered approach to every session. Living and practicing amidst the sacred mountains of Himachal Pradesh, he helps students release stress and cultivate inner balance through mindful asana, pranayama, meditation, and deeply restorative sound healing. His classes invite you to slow down, listen inward, and reconnect — perfectly suited to the tranquil energy of our coconut-shaded shala in Palolem.</p>
          </div> -->
        </div>

        <div class="text-center mt-12">
          <a href="/#contact" class="btn btn-primary px-8 py-4 text-lg">Enquire About Private Sessions</a>
        </div>
      </div>
    </section>

    <!-- Yoga retreats section -->
    <section class="py-16 bg-gray-50">
      <div class="px-6 lg:container lg:mx-auto text-center">
        <h2 class="font-display text-3xl font-bold mb-6 md:text-5xl">Host Your Yoga Retreat or Workshop at Luma Goa</h2>

        <p class="text-lg max-w-3xl mx-auto mb-8 leading-relaxed">
          Offer your group a turn-key, serene venue in Palolem, South Goa. Our elevated 85 m² shala sits in a private coconut grove, a short walk to the beach — ideal for teachers and facilitators seeking calm, natural beauty without distractions.
        </p>

        <p class="text-lg max-w-3xl mx-auto mb-10 leading-relaxed">
          Premium props, ocean breezes, 9 cozy A-frame huts for lodging, and <a href="/ayurveda-massage" class="text-brand-brown underline decoration-primary/30 hover:decoration-primary">on-site massages</a> complete the picture. You lead the sessions; we provide the inspiring backdrop.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mt-8">
          <!-- Benefit Card 1 -->
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <h3 class="font-bold text-xl mb-4">Intimate & Serene Shala</h3>
            <p class="text-gray-700 mb-4">85 m² elevated space for up to 20 participants + teacher — surrounded by coconut palms for ultimate calm and focus.</p>
          </div>

          <!-- Benefit Card 2 -->
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <h3 class="font-bold text-xl mb-4">Beachside Location</h3>
            <p class="text-gray-700 mb-4">Only 200 m from Palolem Beach — perfect for sunrise/sunset sessions, beach walks, or free time between practices.</p>
          </div>

          <!-- Benefit Card 3 -->
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <h3 class="font-bold text-xl mb-4">Accommodation & Extras</h3>
            <p class="text-gray-700 mb-4">9 charming A-frame huts + on-site massage center available — create a complete retreat for your group.</p>
          </div>
        </div>

        <div class="mt-12">
          <p class="text-xl font-semibold mb-6">Ready to bring your retreat to Palolem?</p>
          <div class="flex flex-col sm:flex-row justify-center gap-6">
            <a href="<%= waHref("Hi Luma Goa team, I'm interested in renting your yoga shala and huts for my group or retreat. Please send availability and rates.") %>" class="btn btn-primary px-10 py-5 text-lg inline-flex items-center">
              Enquire via WhatsApp
            </a>
            <a x-data="emailLink" :href="href" class="btn btn-outline px-10 py-5 text-lg">Send Email Enquiry</a>

          </div>
          <p class="mt-6 text-base text-gray-600">
            Custom quotes for groups of 8-16.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <%- include('./src/partials/footer.ejs') %>

  <%- include('./src/partials/whatsapp-float.ejs', {
        message: "Hi LUMA, I'm interested in joining a yoga class or Sound Bath session.",
        label: 'Join a yoga class or Sound Bath on WhatsApp',
      }) %>

  <script type="module" src="/src/main.ts"></script>
</body>

</html>