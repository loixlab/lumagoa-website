<!doctype html>
<html lang="en" data-theme="pastel">
<%- include('./src/partials/head.ejs', {
  title: 'Yoga Holidays Palolem South Goa | LUMA Goa',
  description: `Yoga holidays in Palolem, South Goa. 3, 5 or 7 nights in a boutique A-frame hut with unlimited daily yoga, plant-based breakfast and Ayurvedic massage included. From ${fromPrice}.`,
  ogTitle: 'LUMA Goa | Yoga Holidays in Palolem, South Goa',
  ogDescription: 'Stay, practice and restore. Three, five or seven nights in South Goa with yoga, breakfast and Ayurvedic massage included.',
  extraMeta: `<meta property="og:url" content="${siteUrl}/yoga-holidays">
    <meta property="og:image" content="${siteUrl}/img/yoga-holidays-hero_og.jpg">
    <meta name="twitter:url" content="${siteUrl}/yoga-holidays">
    <meta name="twitter:image" content="${siteUrl}/img/yoga-holidays-hero_twitter.jpg">`,
  extraContent: `<link rel="canonical" href="${siteUrl}/yoga-holidays" />`,
  schemaData: schemaData
}) %>

<body class="bg-white pt-[75px] text-gray-900 antialiased md:pt-[102px]">
  <%- include('./src/partials/analytics-noscript.ejs') %>

  <!-- Header -->
  <%- include('./src/partials/header.ejs') %>

  <main>
    <!-- 1. Hero -->
    <section class="relative min-h-[70vh] flex items-center justify-center py-20 overflow-hidden bg-stone-900">
      <div class="absolute inset-0 z-0">
        <img src="/img/yoga-holidays-hero.jpg" alt="The A-frame huts and tropical gardens of LUMA Goa, Palolem" class="w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-linear-to-b from-stone-900/70  to-stone-900/40"></div>
      </div>

      <div class="container mx-auto px-6 max-w-5xl relative z-1 text-center">
        <div class="space-y-6">
          <h2 class="text-xs uppercase tracking-[0.4em] text-secondary font-bold">
            Yoga, Breakfast &amp; Massage Included &bull; Palolem, South Goa
          </h2>

          <h1 class="text-5xl md:text-7xl font-display text-white leading-tight">
            Stay. Practice. <br /><span class="italic font-light text-stone-300">Restore.</span>
          </h1>

          <p class="text-lg md:text-xl text-stone-200 leading-relaxed max-w-2xl mx-auto">
            Three, five or seven nights in a boutique A-frame hut &mdash; with unlimited yoga, breakfast at Roots &amp; Bloom, and Ayurvedic massage included.
          </p>

          <div class="pt-8">
            <a href="#holidays" x-data="holidayTracking" @click="trackView('hero')" class="btn btn-primary btn-lg rounded-full px-10 font-bold tracking-wide shadow-xl">
              View the yoga holidays
            </a>
          </div>

          <p class="text-sm uppercase tracking-widest text-stone-300">
            Available <%= season.display %>
          </p>
        </div>
      </div>
    </section>

    <!-- 2. What's included -->
    <section class="py-20 md:py-32 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">Every Holiday</span>
          <h2 class="mt-4 text-4xl md:text-5xl font-display text-stone-800 leading-tight">
            Everything you need, <span class="italic text-primary">already included</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-10">
          <div class="flex flex-col items-center text-center space-y-5">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100">
              <img src="/img/icon-sleep.png" alt="A-frame hut icon" class="w-20 h-20" />
            </div>
            <h3 class="text-2xl font-serif text-stone-800">Your A-Frame Hut</h3>
            <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
              Nine boutique huts, each with an open-sky bathroom and a king-size mattress chosen for deep sleep. Minimalist, quiet, and built for recovery.
            </p>
          </div>

          <div class="flex flex-col items-center text-center space-y-5">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100">
              <img src="/img/icon-yoga.png" alt="Yoga icon" class="w-20 h-20" />
            </div>
            <h3 class="text-2xl font-serif text-stone-800">Unlimited Yoga</h3>
            <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
              Morning and evening classes, every day of the week. Hatha, Vinyasa, Kundalini and Yin with our resident teachers &mdash; come to one, come to both, come to all of them.
            </p>
          </div>

          <div class="flex flex-col items-center text-center space-y-5">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100">
              <img src="/img/icon-food.png" alt="Breakfast icon" class="w-20 h-20" />
            </div>
            <h3 class="text-2xl font-serif text-stone-800">Breakfast, Every Morning</h3>
            <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
              Wake up and walk to Roots &amp; Bloom. Vitality juices, protein-rich bowls, smashed avocado on homemade bread &mdash; plant-based fuel for the day ahead.
            </p>
          </div>

          <div class="flex flex-col items-center text-center space-y-5">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100">
              <img src="/img/icon-massage.png" alt="Ayurvedic massage icon" class="w-20 h-20" />
            </div>
            <h3 class="text-2xl font-serif text-stone-800">Ayurvedic Massage</h3>
            <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
              Sixty-minute signature treatments with our experienced therapists, drawing on traditions that have guided Indian healing for centuries.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. The three yoga holidays -->
    <section id="holidays" class="py-20 md:py-32 bg-stone-50 scroll-mt-[75px] md:scroll-mt-[102px]">
      <div class="container mx-auto px-6 max-w-6xl" x-data="seasonSelector">
        <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
          <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">Choose Your Stay</span>
          <h2 class="mt-4 text-4xl md:text-5xl font-display text-stone-800 leading-tight">
            Three, five or seven nights
          </h2>
        </div>

        <!-- Season selector — server renders Low-season prices; without JS the
             page stays a plain Low-season price list. -->
        <div class="mb-12 md:mb-16 text-center">
          <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">Choose your season</span>
          <div role="group" aria-label="Season" class="mt-5 flex flex-wrap justify-center gap-3 md:gap-4">
            <% seasons.forEach(function (s) { %>
            <button type="button" @click="select('<%= s.id %>')" aria-pressed="false" :aria-pressed="isActive('<%= s.id %>').toString()" class="btn btn-lg h-auto rounded-full px-6 py-2 flex-col gap-0 font-medium" :class="isActive('<%= s.id %>') ? 'btn-primary' : 'btn-outline border-stone-300 text-stone-600 hover:border-emerald-700 hover:bg-transparent hover:text-stone-600'">
              <span class="text-base"><%= s.label %></span>
              <span class="text-xs font-normal opacity-80"><%= s.window %></span>
            </button>
            <% }); %>
          </div>
          <p class="sr-only" aria-live="polite" x-text="announcement"></p>
          <div class="mx-auto mt-6 max-w-2xl rounded-xl border border-stone-200 border-l-4 border-l-[#c66f54] bg-white p-5 text-left shadow-sm">
            <p class="text-sm text-stone-600 leading-relaxed">
              <span class="font-bold text-stone-800">Booking across seasons?</span>
              Prices shown are for stays within one season. Stays crossing a season boundary are quoted per night at the applicable rate &mdash; <a href="<%= waHref("Hi LUMA, I'd like a quote for a stay that crosses seasons. My dates are: ") %>" target="_blank" rel="noopener" x-data="holidayTracking" @click="track('cross-season', 'Cross-Season Stay', 0, 'holiday_card')" class="text-emerald-800 underline decoration-emerald-800/30 hover:decoration-emerald-800">just ask</a>.
            </p>
          </div>
          <!-- Without JS the pills are inert and the cards keep their
               server-rendered Low-season prices — say so. -->
          <noscript>
            <% var lowSeason = seasons.find(function (s) { return s.id === "low"; }); %>
            <p class="mt-4 text-center text-sm text-stone-500">
              Prices shown are for low season (<%= lowSeason.window %>). For stays in December &ndash; March, message us for the seasonal rate.
            </p>
          </noscript>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:items-stretch">
          <% holidays.forEach(function (p) { %>
          <article x-data="holidayCard(<%= JSON.stringify(p.client) %>)" class="card rounded-xl bg-white shadow-lg <%= p.featured ? 'relative border-2 border-primary md:scale-105 order-first md:order-none' : 'border border-stone-100' %>">
            <% if (p.featured) { %>
            <span class="badge badge-primary absolute -top-3 left-1/2 -translate-x-1/2 px-4 text-xs font-bold uppercase tracking-widest">Most popular</span>
            <% } %>
            <div class="card-body p-8">
              <h3 class="font-display text-2xl text-stone-800"><%= p.name %></h3>
              <p class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold"><%= p.nights %> nights</p>
              <p class="mt-1 font-serif italic text-stone-500"><%= p.tagline %></p>

              <hr class="my-5 border-stone-200" />

              <ul class="space-y-3 text-stone-700">
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 shrink-0 bg-emerald-700 rounded-full"></span>
                  <span><%= p.nights %> nights in an A-frame hut</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 shrink-0 bg-emerald-700 rounded-full"></span>
                  <span>Unlimited daily yoga</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 shrink-0 bg-emerald-700 rounded-full"></span>
                  <span>Breakfast daily</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 shrink-0 bg-emerald-700 rounded-full"></span>
                  <span><%= p.massages %> &times; 60-min Ayurvedic massage<%= p.massages > 1 ? "s" : "" %></span>
                </li>
                <% if (p.consultation) { %>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 shrink-0 bg-emerald-700 rounded-full"></span>
                  <span>Ayurvedic doctor consultation</span>
                </li>
                <% } %>
              </ul>

              <hr class="my-5 border-stone-200" />

              <div class="space-y-4 grow">
                <div>
                  <p class="flex items-baseline justify-between gap-2">
                    <span class="text-stone-600">Solo</span>
                    <span class="text-2xl font-display text-stone-800" x-text="card.prices[season].solo"><%= p.client.prices.low.solo %></span>
                  </p>
                  <!-- The saving is season-independent (flat ₹500/night room discount) — no binding needed. -->
                  <p class="text-right text-sm text-emerald-800 font-bold">Save <%= formatPrice(p.saving.solo) %> vs booking separately</p>
                </div>
                <div>
                  <p class="flex items-baseline justify-between gap-2">
                    <span class="text-stone-600">Two sharing</span>
                    <span class="text-2xl font-display text-stone-800"><span x-text="card.prices[season].double"><%= p.client.prices.low.double %></span> <span class="text-sm font-sans text-stone-500">total</span></span>
                  </p>
                  <p class="text-right text-sm text-emerald-800 font-bold">Save <%= formatPrice(p.saving.double) %> vs booking separately</p>
                </div>
              </div>

              <div class="card-actions mt-6">
                <a href="<%= p.client.wa.low %>" :href="card.wa[season]" target="_blank" rel="noopener" x-data="holidayTracking" @click="track('<%= p.id %>', '<%= p.name %>', card.values[season], 'holiday_card', season)" class="btn btn-primary btn-block rounded-full font-bold shadow-xl">
                  Enquire on WhatsApp
                </a>
                <p class="mt-2 w-full text-center text-sm text-stone-500" x-data="holidayTracking">
                  or <a x-data="emailLink" :href="href" @click="track('<%= p.id %>', '<%= p.name %>', card.values[season], 'holiday_card', season)" class="text-emerald-800 underline decoration-emerald-800/30 hover:decoration-emerald-800">enquire by email</a>
                </p>
              </div>
            </div>
          </article>
          <% }); %>
        </div>

        <div class="mt-10 text-center text-sm text-stone-500 space-y-2">
          <p>All prices in INR.</p>
          <p>
            Staying longer, or for four or six nights? We'll build it around you &mdash;
            <a href="<%= waHref("Hi LUMA, I'd like to enquire about a custom-length yoga holiday. My dates are: ") %>" target="_blank" rel="noopener" x-data="holidayTracking" @click="track('custom', 'Custom Yoga Holiday', 0, 'holiday_card')" class="text-emerald-800 underline decoration-emerald-800/30 hover:decoration-emerald-800">just ask</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. A day at LUMA -->
    <section class="py-20 md:py-32 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">Daily Rhythm</span>
          <h2 class="mt-4 text-4xl md:text-5xl font-display text-stone-800 leading-tight">
            A day at <span class="italic text-primary">LUMA</span>
          </h2>
        </div>

        <ol class="relative mx-auto max-w-2xl space-y-10 border-s-2 border-stone-200 ps-8">
          <% timeline.forEach(function (item) { %>
          <li class="relative">
            <span class="absolute -start-[39px] top-1.5 h-3 w-3 rounded-full bg-emerald-700"></span>
            <p class="text-xs uppercase tracking-widest text-emerald-800 font-bold"><%= item.time %></p>
            <h3 class="mt-1 font-serif text-xl text-stone-800"><%= item.title %></h3>
            <p class="mt-1 text-stone-600 leading-relaxed"><%= item.text %></p>
          </li>
          <% }); %>
        </ol>

        <p class="mt-14 text-center font-serif italic text-lg text-stone-500 max-w-2xl mx-auto">
          Arriving in the afternoon? You'll still make the evening practice. Leaving in the morning? Start with one last flow.
        </p>
      </div>
    </section>

    <!-- 5. The massage inclusion — the treatment menu itself lives on /ayurveda-massage (one source of truth) -->
    <section class="py-16 md:py-24 bg-stone-50">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

          <div class="space-y-6">
            <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">The Massage Inclusion</span>
            <h2 class="text-4xl md:text-5xl font-display text-stone-800 leading-tight">
              Choose your <span class="italic text-primary">treatment</span>
            </h2>
            <p class="text-stone-600 text-lg leading-relaxed">
              Your yoga holiday includes a 60-minute full-body signature treatment for each person &mdash; yours to choose from <%= includedCountWord %> of our most-loved therapies.
            </p>
            <p class="text-stone-600 text-lg leading-relaxed">
              Staying five or seven nights? Take a different treatment each time. Our therapists will suggest a sequence: Abhyangam to ground and open, Marma to restore energy flow, Podikizhi to release and detoxify.
            </p>
            <p class="text-stone-600 text-lg leading-relaxed">
              Prefer the Ayurvedic Body Scrub, Njavarakizhi, or a 90-minute combination? Simply pay the difference at reception.
            </p>
          </div>

          <div class="card rounded-xl border border-stone-100 bg-white shadow-lg">
            <div class="card-body gap-6 p-8 md:p-10">
              <h3 class="card-title text-2xl font-serif font-normal text-stone-800">The <%= includedCountWord %> included treatments</h3>
              <ul class="space-y-3 text-stone-700">
                <% includedTreatments.forEach(function (t) { %>
                <li class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 shrink-0 bg-emerald-700 rounded-full"></span>
                  <span><%= t.title %></span>
                </li>
                <% }); %>
              </ul>
              <p class="text-stone-600 leading-relaxed">
                Every treatment, with its story, duration and price, lives on our treatment centre page.
              </p>
              <div>
                <a href="/ayurveda-massage" class="btn btn-outline rounded-full border-stone-800 px-8 font-bold text-stone-800 hover:border-stone-800 hover:bg-stone-100 hover:text-stone-800">
                  Explore the treatments &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-12 max-w-3xl text-sm text-stone-500 leading-relaxed">
          Head, foot, face and back treatments, and doctor-prescribed therapies, are available from our <a href="/ayurveda-massage" class="text-emerald-800 underline decoration-emerald-800/30 hover:decoration-emerald-800">full menu</a> as add-ons. One treatment per day, ideally 48 hours apart, as Ayurvedic practice recommends.
        </p>
      </div>
    </section>

    <!-- 6. Guest reviews — brand-cream band, distinct from the stone-50
         massage section above and the white booking section below -->
    <%- include('./src/partials/reviews.ejs', { bg: 'bg-brand-cream' }) %>

    <!-- 7. How booking works -->
    <section class="py-20 md:py-32 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">Simple By Design</span>
          <h2 class="mt-4 text-4xl md:text-5xl font-display text-stone-800 leading-tight">
            How booking <span class="italic text-primary">works</span>
          </h2>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8">
          <li class="flex flex-col items-center text-center space-y-4">
            <span class="w-12 h-12 rounded-full bg-stone-800 text-white flex items-center justify-center font-display text-xl">1</span>
            <h3 class="font-serif text-xl text-stone-800">Send us a message</h3>
            <p class="text-stone-600 leading-relaxed">Tell us your dates, which holiday, and how many of you.</p>
          </li>
          <li class="flex flex-col items-center text-center space-y-4">
            <span class="w-12 h-12 rounded-full bg-stone-800 text-white flex items-center justify-center font-display text-xl">2</span>
            <h3 class="font-serif text-xl text-stone-800">We confirm</h3>
            <p class="text-stone-600 leading-relaxed">We check the hut and reply, usually within a few hours.</p>
          </li>
          <li class="flex flex-col items-center text-center space-y-4">
            <span class="w-12 h-12 rounded-full bg-stone-800 text-white flex items-center justify-center font-display text-xl">3</span>
            <h3 class="font-serif text-xl text-stone-800">Secure with a deposit</h3>
            <p class="text-stone-600 leading-relaxed">A 50% deposit confirms your dates.</p>
          </li>
          <li class="flex flex-col items-center text-center space-y-4">
            <span class="w-12 h-12 rounded-full bg-stone-800 text-white flex items-center justify-center font-display text-xl">4</span>
            <h3 class="font-serif text-xl text-stone-800">Settle on arrival</h3>
            <p class="text-stone-600 leading-relaxed">The balance is due at check-in. Nothing else to think about.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- 8. Good to know -->
    <section class="py-16 md:py-24 bg-stone-50">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs uppercase tracking-[0.3em] text-emerald-800 font-bold">The Details</span>
          <h2 class="mt-4 text-4xl md:text-5xl font-display text-stone-800 leading-tight">
            Good to <span class="italic text-primary">know</span>
          </h2>
        </div>

        <%
        // The accordion items as data — one markup block below renders them
        // all, so chrome tweaks happen once and indices can't drift.
        var accordionLink = "text-emerald-800 underline decoration-emerald-800/30 hover:decoration-emerald-800";
        var highSeason = seasons.find(function (s) { return s.id === "high"; });
        var goodToKnow = [
          {
            title: "What's not included",
            body: `Lunch, dinner, airport transfer, treatments beyond those listed, and any special activity happening at LUMA.`,
          },
          {
            title: "Yoga schedule",
            body: `Morning and evening classes run daily. Class styles rotate through the week; the full schedule is on the <a href="/yoga-shala" class="${accordionLink}">Yoga Shala page</a>.`,
          },
          {
            title: "Booking your massages",
            body: `Please choose your treatment times at check-in. Our therapists are in demand and we want to guarantee your slot.`,
          },
          {
            title: "Arrival and departure",
            body: `Check-in from ${stay.checkIn}, check-out by ${stay.checkOut}.`,
          },
          {
            title: "Deposits and changes",
            body: `A 50% deposit confirms your booking. It's fully refundable up to 15 days before arrival &mdash; 30 days during high season (${highSeason.window}) &mdash; and the balance is due at check-in. Full details in our <a href="/terms-and-services" class="${accordionLink}">Terms of Service</a>.`,
          },
          {
            title: "Season",
            body: `Yoga holidays are available ${season.display}.`,
          },
        ];
        %>
        <div x-data="holidaysAccordion" class="mx-auto max-w-3xl divide-y divide-stone-200 border-y border-stone-200">
          <% goodToKnow.forEach(function (item, i) { %>
          <div>
            <h3>
              <button type="button" @click="toggle(<%= i %>)" aria-expanded="false" :aria-expanded="isOpen(<%= i %>).toString()" aria-controls="good-to-know-<%= i %>" class="flex w-full cursor-pointer items-center justify-between gap-4 py-5 text-left font-serif text-lg text-stone-800 transition-colors hover:text-emerald-800">
                <%= item.title %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-stone-400 motion-safe:transition-transform" :class="isOpen(<%= i %>) ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </h3>
            <div id="good-to-know-<%= i %>" x-show="isOpen(<%= i %>)" x-cloak class="pb-5 text-stone-600 leading-relaxed">
              <%- item.body %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- 9. Final CTA -->
    <section class="bg-base-100 py-20 md:py-32 text-white border-b-1 border-stone-800" data-theme="dim">
      <div class="container mx-auto px-6 max-w-6xl text-center space-y-8">
        <h2 class="text-4xl md:text-5xl font-display text-white leading-tight">
          Your week starts whenever you're ready.
        </h2>
        <p class="text-lg text-stone-300 leading-relaxed max-w-2xl mx-auto">
          Nine huts, and they fill early in season. Tell us your dates and we'll hold one for you.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-6 pt-4">
          <a href="<%= waHref("Hi LUMA, I'd like to enquire about a yoga holiday. My dates are: ") %>" target="_blank" rel="noopener" x-data="holidayTracking" @click="track('general', 'LUMA Yoga Holiday', 0, 'final_cta')" class="btn btn-primary btn-lg rounded-full px-10 font-bold shadow-xl">
            Enquire on WhatsApp
          </a>
