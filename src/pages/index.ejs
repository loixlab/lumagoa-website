<!doctype html>
<html lang="en" data-theme="pastel">
<%- include('./src/partials/head.ejs', {
  title: 'Boutique Yoga Resort Palolem South Goa | LUMA Goa',
  description: 'Experience the premier Boutique Yoga Resort in Palolem. Stay in unique A-frame huts, enjoy plant-based dining at Roots & Bloom, and join daily yoga classes in South Goa.',
  ogTitle: 'LUMA Goa | Boutique Yoga Resort Palolem',
  ogDescription: 'Discover a coastal hideaway for the mindful. Boutique A-frame huts and authentic yoga in the heart of South Goa.',
  extraMeta: ` <meta property="og:url" content="${siteUrl}/">
  <meta property="og:image" content="${siteUrl}/img/home-hero_og.jpg" />
  <meta name="twitter:url" content="${siteUrl}/">
  <meta name="twitter:image" content="${siteUrl}/img/home-hero_twitter.jpg">`,
  extraContent: `<link rel="canonical" href="${siteUrl}/" />`,
  schemaData: {
    "@context": "https://schema.org",
    "@type": "Hotel",
    "name": "LUMA Goa",
    "description": "Boutique Yoga Resort in Palolem, South Goa, featuring high-end A-frame huts, a shaded yoga shala, and plant-based café.",
    "url": siteUrl + "/",
    "telephone": phone.display,
    "email": email,
    "priceRange": "$$",
    "image": siteUrl + "/img/home-hero_display.jpg",
    "numberOfRooms": 9,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Palolem Down St, Palolem, Canacona",
      "addressLocality": "South Goa",
      "addressRegion": "Goa",
      "postalCode": "403702",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 15.0126252,
      "longitude": 74.0210419
    },
    "amenityFeature": [
      {
        "@type": "LocationFeatureSpecification",
        "name": "Yoga Shala",
        "value": true
      },
      {
        "@type": "LocationFeatureSpecification",
        "name": "Plant-Based Café",
        "value": true
      },
      {
        "@type": "LocationFeatureSpecification",
        "name": "Open-sky Bathrooms",
        "value": true
      }
    ],
    "sameAs": [
      "https://www.facebook.com/lumagoa",
      "https://www.instagram.com/luma.goa/"
    ]
  }
}) %>

<body class="bg-white pt-[75px] text-gray-900 antialiased md:pt-[102px]">
  <%- include('./src/partials/analytics-noscript.ejs') %>

  <!-- Header -->
  <%- include('./src/partials/header.ejs') %>

  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/img/home-hero_display.jpg" alt="Boutique Yoga Resort in Palolem South Goa - LUMA A-frame huts" class="w-full h-full object-cover scale-105 animate-slow-zoom" />
        <div class="absolute inset-0 bg-stone-900/60"></div>
      </div>

      <div class="container mx-auto py-8 px-6 relative z-1 text-center">
        <div class="max-w-4xl mx-auto space-y-8">

          <h2 class="inline-block text-white uppercase tracking-[0.4em] text-xs font-bold animate-fade-in-down">
            Premier Yoga Retreat &bull; Palolem South Goa.
          </h2>

          <h1 class="text-5xl md:text-7xl lg:text-8xl font-display text-white leading-tight">
            A Boutique <span class="italic font-light text-stone-200 underline decoration-stone-200/30">Yoga Resort</span> for the Mindful.
          </h1>

          <p class="text-lg md:text-2xl text-stone-100 max-w-2xl mx-auto font-light leading-relaxed">
            Rest. Rejuvenate. Recharge. <br class="hidden md:block" />
            Experience our unique A-frame huts and shaded yoga shala in the heart of South Goa.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center pt-8">
            <a href="/booking" class="px-10 py-4 bg-[#c66f54] text-white rounded-full font-bold hover:bg-opacity-90 transition-all shadow-xl">
              Book Your Stay
            </a>

            <a href="/yoga-shala" class="hidden px-8 py-4 bg-transparent border border-white/40 text-white rounded-full font-semibold hover:bg-white/10 transition-all backdrop-blur-sm sm:flex items-center justify-center gap-2">
              Yoga Shala
            </a>

            <a href="/ayurveda-massage" class="hidden px-8 py-4 bg-transparent border border-white/40 text-white rounded-full font-semibold hover:bg-white/10 transition-all backdrop-blur-sm sm:flex items-center justify-center gap-2">
              Ayurveda & Massage
            </a>

            <a href="/cafe-restaurant" class="hidden px-8 py-4 bg-transparent border border-white/40 text-white rounded-full font-semibold hover:bg-white/10 transition-all backdrop-blur-sm sm:flex items-center justify-center gap-2">
              Roots & Bloom Café
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-32 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">

        <div class="text-center max-w-3xl mx-auto mb-20">
          <h2 class="text-sm uppercase tracking-[0.4em] text-brand-brown font-semibold mb-4">The LUMA Ecosystem</h2>
          <p class="text-3xl md:text-4xl font-serif text-stone-800 leading-tight">
            A space designed for <span class="italic font-light">holistic alignment.</span>
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 lg:gap-12">

          <div class="flex flex-col items-center text-center space-y-6 group">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100 group-hover:bg-brand-cream transition-colors duration-500">
              <img src="/img/icon-yoga.png" alt="Nature icon" class="w-20 h-20 text-white" />
            </div>
            <div class="space-y-3">
              <h3 class="text-2xl font-serif text-stone-800">Recharge</h3>
              <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
                Find your center in our shaded Yoga Shala. From transformative morning flows to restorative sound baths, we offer movement that realigns your spirit.
              </p>
            </div>
            <a href="/yoga-shala" class="text-xs uppercase tracking-widest font-bold text-stone-400 hover:text-brand-brown transition-colors">Discover Shala &rarr;</a>
          </div>

          <div class="flex flex-col items-center text-center space-y-6 group">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100 group-hover:bg-brand-cream transition-colors duration-500">
              <img src="/img/icon-sleep.png" alt="Nature icon" class="w-20 h-20 text-white" />
            </div>
            <div class="space-y-3">
              <h3 class="text-2xl font-serif text-stone-800">Rest</h3>
              <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
                Surrender to the sounds of nature in our 9 boutique A-frame huts. Minimalist design and open-sky bathrooms created for the deepest recovery.
              </p>
            </div>
            <a href="#rooms" class="text-xs uppercase tracking-widest font-bold text-stone-400 hover:text-brand-brown transition-colors">The Huts &rarr;</a>
          </div>

          <div class="flex flex-col items-center text-center space-y-6 group">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100 group-hover:bg-brand-cream transition-colors duration-500">
              <img src="/img/icon-food.png" alt="Nature icon" class="w-20 h-20 text-white" />
            </div>
            <div class="space-y-3">
              <h3 class="text-2xl font-serif text-stone-800">Rejuvenate</h3>
              <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
                Nourish with intention at Roots & Bloom. Our vegan and vegetarian menu is the vibrant fuel your body needs to feel light and alive.
              </p>
            </div>
            <a href="/cafe-restaurant" class="text-xs uppercase tracking-widest font-bold text-stone-400 hover:text-brand-brown transition-colors">The Café &rarr;</a>
          </div>

          <div class="flex flex-col items-center text-center space-y-6 group">
            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center border border-stone-100 group-hover:bg-brand-cream transition-colors duration-500">
              <img src="/img/icon-massage.png" alt="Ayurveda icon" class="w-20 h-20 text-white" />
            </div>
            <div class="space-y-3">
              <h3 class="text-2xl font-serif text-stone-800">Restore</h3>
              <p class="text-stone-600 leading-relaxed text-sm lg:text-base">
                Surrender to ancient hands at our Ayurvedic treatment centre. Twenty-five traditional therapies with warm herbal oils, matched to your body by experienced therapists.
              </p>
            </div>
            <a href="/ayurveda-massage" class="text-xs uppercase tracking-widest font-bold text-stone-400 hover:text-brand-brown transition-colors">Ayurveda & Massage &rarr;</a>
          </div>

        </div>
      </div>
    </section>

    <section id="sanctuary" class="py-16 md:py-24 bg-stone-100 overflow-hidden">
      <div class="container mx-auto px-6 max-w-6xl">

        <div class="mb-16 md:mb-24">
          <h2 class="text-3xl md:text-5xl font-display text-stone-800 mb-6 italic">Where balance is found<br class="hidden md:block" /> at every corner.</h2>
        </div>

        <div class="space-y-24 md:space-y-32">

          <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
            <div class="w-full md:w-1/2">
              <div class="aspect-[4/5] md:aspect-square overflow-hidden rounded-[2rem] shadow-sm">
                <img src="/img/yoga-shala-experience.jpg" alt="LUMA Yoga Shala Palolem" class="w-full h-full object-cover" />
              </div>
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span class="text-xs uppercase tracking-[0.3em] text-brand-brown font-bold">Soulful Movement</span>
              <h3 class="text-3xl md:text-4xl font-display text-stone-800">The Yoga Shala</h3>
              <p class="text-stone-600 text-lg leading-relaxed">
                A shaded Shala that stays cool through the day, equipped with high-quality mats and props. Whether it's a dynamic morning flow to wake the body or a candlelit sound bath to soothe the mind, our Shala is the heart of your daily recharge.
              </p>
              <div class="pt-4">
                <a href="/yoga-shala" class="px-8 py-4 bg-brand-brown text-white rounded-full inline-block hover:bg-stone-700 transition-all">
                  View Class Schedule
                </a>
              </div>
            </div>
          </div>

          <div class="flex flex-col md:flex-row-reverse items-center gap-12 lg:gap-20">
            <div class="w-full md:w-1/2">
              <div class="aspect-[4/5] md:aspect-square overflow-hidden rounded-[2rem] shadow-sm">
                <img src="/img/ayurveda-massage-area.jpg" alt="Ayurvedic Treatment Centre at LUMA" class="w-full h-full object-cover" />
              </div>
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span class="text-xs uppercase tracking-[0.3em] text-brand-brown font-bold">Ancient Healing</span>
              <h3 class="text-3xl md:text-4xl font-display text-stone-800">Ayurveda & Massage</h3>
              <p class="text-stone-600 text-lg leading-relaxed">
                Surrender to ancient hands at our private treatment centre. We offer traditional Ayurvedic therapies with warm herbal oils and personalised techniques, matched to your body by experienced therapists.
              </p>
              <div class="pt-4">
                <a href="/ayurveda-massage" class="px-8 py-4 bg-brand-brown text-white rounded-full inline-block hover:bg-stone-700 transition-all">
                  Explore Treatments
                </a>
              </div>
            </div>
          </div>

          <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
            <div class="w-full md:w-1/2">
              <div class="aspect-[4/5] md:aspect-square overflow-hidden rounded-[2rem] shadow-sm">
                <img src="/img/cafe-hero_display.jpg" alt="Roots & Bloom Cafe at LUMA" class="w-full h-full object-cover" />
              </div>
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span class="text-xs uppercase tracking-[0.3em] text-brand-brown font-bold">Vibrant Nutrition</span>
              <h3 class="text-3xl md:text-4xl font-display text-stone-800">Roots & Bloom Café</h3>
              <p class="text-stone-600 text-lg leading-relaxed">
                Fuel your rejuvenation with South Goa's premier plant-based dining experience. We believe food is medicine, serving up vibrant Buddha bowls, freshly made juices, and healthy treats that never compromise on flavor.
              </p>
              <div class="pt-4 flex flex-wrap gap-4">
                <a href="/cafe-restaurant" class="px-8 py-4 bg-brand-brown text-white rounded-full inline-block hover:bg-stone-700 transition-all">
                  The Café Experience
                </a>
                <a href="https://rootsandbloomcafe.com/menu.pdf" target="_blank" rel="noopener noreferrer" class="px-8 py-4 border border-brand-brown text-stone-800 rounded-full inline-block hover:bg-stone-50 transition-all">
                  Browse Menu
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section id="rooms" class="py-20 md:py-32 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">

        <div class="flex flex-col lg:flex-row items-center gap-16">

          <div class="w-full lg:w-2/5 space-y-8 order-2 lg:order-1">
            <div class="space-y-4">
              <span class="text-xs uppercase tracking-[0.3em] text-brand-brown font-bold">Mindful Rest</span>
              <h2 class="text-4xl md:text-5xl font-display text-stone-800 leading-tight">
                Our Signature <br />
                <span class="italic font-light">A-Frame Huts</span>
              </h2>
            </div>

            <p class="text-stone-600 text-lg leading-relaxed">
              Designed with a minimalist aesthetic to clear the mind, our 9 boutique huts offer a unique blend of coastal comfort and natural immersion.
            </p>

            <ul class="space-y-4 text-stone-700">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 bg-emerald-700 rounded-full"></span>
                <span>Open-sky bathrooms for starlit showers</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 bg-emerald-700 rounded-full"></span>
                <span>Eco-conscious materials and natural ventilation</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 bg-emerald-700 rounded-full"></span>
                <span>High-quality King Size mattresses for ultimate recovery</span>
              </li>
            </ul>

            <div class="pt-6">
              <a href="/booking" target="_blank" class="px-10 py-4 bg-brand-brown text-white rounded-full inline-block hover:bg-stone-700 transition-all shadow-lg">
                Book now
              </a>
            </div>
          </div>

          <div class="w-full lg:w-3/5 order-1 lg:order-2">
            <div class="grid grid-cols-12 gap-4">
              <div class="col-span-8 overflow-hidden rounded-[2rem] shadow-sm aspect-[4/5]">
                <img src="/img/hut-exterior.jpg" alt="LUMA A-Frame Hut Exterior" class="w-full h-full object-cover" />
              </div>
              <div class="col-span-4 space-y-4">
                <div class="overflow-hidden rounded-[1.5rem] shadow-sm aspect-square">
                  <img src="/img/hut-interior.jpg" alt="LUMA Hut Interior Design" class="w-full h-full object-cover" />
                </div>
                <div class="overflow-hidden rounded-[1.5rem] shadow-sm aspect-[3/4]">
                  <img src="/img/open-sky-bathroom.jpg" alt="LUMA Open-sky bathroom" class="w-full h-full object-cover" />
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Yoga holidays band -->
    <section id="holidays-band" class="py-16 md:py-24 bg-stone-50">
      <div class="container mx-auto px-6 max-w-6xl text-center">
        <span class="text-xs uppercase tracking-[0.3em] text-brand-brown font-bold">Yoga, Breakfast &amp; Massage Included</span>
        <h2 class="mt-4 text-3xl md:text-4xl font-display text-stone-800 leading-tight">
          Stay. Practice. <span class="italic font-light">Restore.</span>
        </h2>
        <p class="mt-6 text-stone-600 text-lg leading-relaxed max-w-2xl mx-auto">
          Three, five or seven nights in an A-frame hut &mdash; with unlimited daily yoga, breakfast at Roots &amp; Bloom, and Ayurvedic massage included.
        </p>
        <div class="mt-8">
          <a href="/yoga-holidays" class="px-10 py-4 bg-primary text-white rounded-full hover:bg-opacity-90 transition-all shadow-xl inline-block">
            View the Yoga Holidays
          </a>
        </div>
      </div>
    </section>

    <section id="gallery-preview" class="py-20 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 class="text-xs uppercase tracking-[0.4em] text-brand-brown font-bold mb-4">Atmosphere</h2>
            <p class="text-3xl font-serif text-stone-800 italic">The Rhythm of Luma</p>
          </div>
          <a href="/gallery" class="text-sm font-bold border-b-2 border-brand pb-1 text-brand hover:text-stone-800 hover:border-brand-brown transition-all">
            View Full Gallery &rarr;
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="col-span-2 row-span-2 overflow-hidden rounded-3xl">
            <img src="/img/gallery/hero-vibe.jpg" alt="LUMA Sanctuary Atmosphere" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
          </div>
          <div class="overflow-hidden rounded-2xl">
            <img src="/img/gallery/yoga-detail.jpg" alt="Yoga Shala Detail" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
          </div>
          <div class="overflow-hidden rounded-2xl">
            <img src="/img/gallery/matcha.jpg" alt="Roots & Bloom Healthy Plate" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
          </div>
          <div class="col-span-2 overflow-hidden rounded-2xl aspect-video">
            <img src="/img/gallery/signs.jpg" alt="A-Frame Hut at Sunset" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
          </div>
        </div>
      </div>
    </section>

    <!-- Guest reviews -->
    <%- include('./src/partials/reviews.ejs', { bg: 'bg-brand-cream' }) %>

    <!-- Contact section -->
    <section id="contact" class="py-20 md:py-32 bg-stone-100">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex flex-col lg:flex-row gap-16 items-start">

          <div class="w-full lg:w-1/3 space-y-10">
            <div>
              <h2 class="text-xs uppercase tracking-[0.4em] text-brand-brown font-bold mb-4">Location</h2>
              <h3 class="text-4xl font-display text-stone-800 italic">Visit Us</h3>
            </div>

            <div class="space-y-6 text-stone-600">
              <div class="space-y-1">
                <p class="text-xs uppercase tracking-widest text-stone-400 font-bold">The Address</p>
                <p class="text-lg">Palolem Down St, Palolem<br />Canacona, South Goa 403702</p>
              </div>

              <div class="space-y-1">
                <p class="text-xs uppercase tracking-widest text-stone-400 font-bold">Direct Lines</p>
                <p class="text-lg"><a href="tel:<%= phone.tel %>" class="hover:text-brand-brown transition-colors"><%= phone.display %></a></p>
                <p class="text-lg">
                  <a x-data="emailLink" :href="href" x-text="address" class="hover:text-brand-brown transition-colors"></a>
                </p>
              </div>
            </div>

            <div class="pt-6 border-t border-stone-200">
              <h4 class="font-serif text-xl text-stone-800 mb-3">The Neighborhood</h4>
              <p class="text-stone-500 leading-relaxed text-sm">
                Tucked away just steps from the quietest end of Palolem Beach. Explore the local rhythm of South Goa—from seaside meditation to the vibrant textile markets of Canacona.
              </p>
            </div>
          </div>

          <div class="w-full lg:w-2/3">
            <div class="relative group">
              <div id="map" x-data="googleMap('sanctuary')" class="h-[500px] w-full rounded-[2.5rem] shadow-sm overflow-hidden border-8 border-white"></div>

              <div class="absolute bottom-8 left-8">
                <a href="https://maps.app.goo.gl/3X2A7i63LgKMqEARA" target="_blank" rel="noopener" class="bg-white text-stone-800 px-6 py-3 rounded-full shadow-xl text-sm font-bold flex items-center gap-2 hover:bg-emerald-50 transition-all">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Open in Google Maps
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <!-- Quote Section -->
  <!-- <section class="py-20 bg-white border-t border-stone-100">
    <div class="container mx-auto px-6 text-center">
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="flex justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-brown/30" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.154c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
