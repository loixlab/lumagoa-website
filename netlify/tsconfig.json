{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    /* Serverless (Node) runtime — bundled by Netlify/esbuild: */
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2023",
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["functions/**/*.ts"]
}
